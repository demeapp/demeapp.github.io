ription LiabilitiesTwo mortgages with RBC, joint with spouse.Home equity line of credit with RBC, joint with spouse.Vehicle loan with Toyota Financing Canada. Disclosed on November 4, 2025","url":"https://www.ethicscanada.ca/en/public-registry/Details?declarationId=e927cf09-c7b8-f011-819e-001dd8b72449"}],"other":[]},"lobbying":{"total":253,"first":"2019-12-12","last":"2026-10-06","byYear":{"2019":6,"2020":63,"2021":53,"2022":22,"2023":32,"2024":26,"2025":22,"2026":29},"topSubjects":[["Health",76],["Economic Development",35],["Budget",31],["Fisheries",31],["Research and Development",28],["Agriculture",26],["International Trade",23],["Science and Technology",21]],"topOrgs":[["Maritime Fisheries Union",37],["Breakthrough T1D",14],["Dairy Farmers of Nova Scotia",14],["Irving Shipbuilding Inc.",12],["Quota Allocation Working Group",10],["Chicken Farmers of Canada",8],["Cystic Fibrosis Canada",8],["Dairy Farmers of Canada",5]]}}