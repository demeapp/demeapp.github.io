iament OCIEC Translation Declaration type Disclosure Summaries (Code) Disclosure date February 12, 2026 Regime Conflict of Interest Code for Members of the House of Commons Description LiabilitiesGuarantor of two mortgages, for an individual, with the Caisse Desjardins des Rivières.Spouse's/Common-Law Partner's liabilitiesMortgage with the Royal Bank of Canada. Disclosed on February 12, 2026","url":"https://www.ethicscanada.ca/en/public-registry/Details?declarationId=b425fde7-9dec-f011-81a0-001dd8b72449"}],"other":[]},"lobbying":{"total":773,"first":"2016-01-14","last":"2026-06-22","byYear":{"2016":33,"2017":44,"2018":39,"2019":25,"2020":15,"2021":18,"2022":92,"2023":206,"2024":189,"2025":88,"2026":24},"topSubjects":[["Environment",260],["Energy",155],["Industry",123],["Climate",116],["Economic Development",103],["Transportation",78],["Taxation and Finance",73],["Infrastructure",57]],"topOrgs":[["Canadian Federation of Independent Business (CFIB)",12],["FEDERATION OF CANADIAN MUNICIPALITIES",9],["Canadian Chamber of Commerce",8],["Chemistry Industry Association of Canada",8],["Electric Mobility Canada",8],["Canadian Vehicle Manufacturers' Association",8],["Tourmaline Oil Corp.",7],["Canadian RV Coalition",7]]}}