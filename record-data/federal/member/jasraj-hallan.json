closure date December 18, 2025 Regime Conflict of Interest Code for Members of the House of Commons Description My sources of income, assets and liabilities disclosed in my Disclosure Statement are not mentioned pursuant to subsection 24(3) of the Conflict of Interest Code for Members of the House of Commons. Disclosed on December 18, 2025 Commissioner's Office Financial reports Job opportunities Contact us Sets of rules Read the Act Read the Code Stay connected Important notices Accessibility var messages = {}; messages.showMore = 'Show more'; messages.showLess = 'Show less'; messages.languageCode = 'en' messages.allSectionsExpanded = 'All sections have been expanded'; messages.allSectionsCollapsed = 'All sections have been collapsed';","url":"https://www.ethicscanada.ca/en/public-registry/Details?declarationId=af371b87-b7c4-4a87-9fa1-297c72f6fa10"}],"other":[]},"lobbying":{"total":303,"first":"2020-01-14","last":"2026-09-24","byYear":{"2020":11,"2021":19,"2022":54,"2023":94,"2024":59,"2025":33,"2026":33},"topSubjects":[["Taxation and Finance",75],["Financial Institutions",52],["Economic Development",44],["Consumer Issues",34],["Industry",30],["Energy",29],["Environment",29],["Budget",27]],"topOrgs":[["Fintechs Canada",10],["Canadian Bankers Association",9],["National Council of Canadian Muslims (NCCM)",6],["Metis Nation of British Columbia",6],["Cystic Fibrosis Canada",5],["ROYAL BANK OF CANADA",5],["Scotiabank",5],["Shakepay Inc.",5]]}}