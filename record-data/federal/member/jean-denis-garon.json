 months: Employment income from Mouvement DesjardinsNext 12 months: Employment income from Mouvement Desjardins Disclosed on February 27, 2026","url":"https://www.ethicscanada.ca/en/public-registry/Details?declarationId=f3340e68-e1b1-4f19-a47f-ac525886a4b9"}],"other":[]},"lobbying":{"total":200,"first":"2021-11-16","last":"2026-09-25","byYear":{"2021":2,"2022":30,"2023":26,"2024":62,"2025":42,"2026":38},"topSubjects":[["International Trade",21],["Taxation and Finance",21],["Economic Development",19],["Industry",18],["Agriculture",18],["Internal Trade",15],["Health",13],["Labour",10]],"topOrgs":[["Canadian Federation of Independent Business (CFIB)",7],["Aerospace Industries Association of Canada",6],["Canopy Growth Corporation",5],["Bombardier Inc.",5],["Google Canada Corporation",4],["Rogers Communications Inc.",4],["L3Harris Technologies Canada Inc.",4],["Unifor",3]]}}